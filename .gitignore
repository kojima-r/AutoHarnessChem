__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/

# downloaded models (e.g. `ln -s /path/to/aizynth_data data/aizynth`)
data/

# demo output (regenerated by `ahc demo` / examples/run_examples.sh)
examples/output/

# runtime output (regenerated per run)
workspaces/*
!workspaces/.gitkeep
traces/*
!traces/.gitkeep

# compiled skill deployments (regenerated by `ahc skills compile`)
.claude/skills/
build/skills/

# evolver output (proposals are reviewed as git diffs, not committed automatically)
evolver/proposals/

# secrets
.env
