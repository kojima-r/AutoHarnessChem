__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/

# downloaded models (e.g. `ln -s /path/to/aizynth_data data/aizynth`)
data/

# demo output (regenerated by `ahc demo` / examples/run_examples.sh)
examples/output/

# runtime output (regenerated per run)
workspaces/*
!workspaces/.gitkeep
traces/*
!traces/.gitkeep

# node（任意: `npm install --no-save jsdom` で構造描画テストを有効化するときだけ作られる）
node_modules/
package-lock.json

# compiled skill deployments (regenerated by `ahc skills compile`)
.claude/skills/
build/skills/

# evolver output (proposals are reviewed as git diffs, not committed automatically)
evolver/proposals/

# secrets
.env

# ChemEval: ダウンロードしたデータセットと評価結果（再生成できる）
benchmarks_chemeval/data/
benchmarks_chemeval/results/
# ChemEval 公式リポジトリのクローン（独自 .git を持つ入れ子。親にはコミットしない）
benchmarks_chemeval/ChemEval/
